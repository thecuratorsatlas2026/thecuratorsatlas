---
import Base from '../../../../layouts/Base.astro';
import JournalList from '../../../../components/JournalList.astro';
import { categories, categoryLabels, langs, type Category, type Lang } from '../../../../i18n/ui';
import { getArticles } from '../../../../lib/journal';
export function getStaticPaths() {
  return langs.flatMap((lang) => categories.map((category) => ({ params: { lang, category } })));
}
const lang = Astro.params.lang as Lang;
const category = Astro.params.category as Category;
const articles = (await getArticles(lang)).filter((a) => a.data.category === category);
const label = categoryLabels[lang][category];
---
<Base lang={lang} title={label.title} description={label.blurb}>
  <JournalList lang={lang} articles={articles} active={category} />
</Base>
