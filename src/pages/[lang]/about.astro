---
import Base from '../../layouts/Base.astro';
import Plate from '../../components/Plate.astro';
import { SITE } from '../../config';
import { langs, path, t, type Lang } from '../../i18n/ui';
export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;

// ✎ Editá libremente estos textos. Los corchetes [ ] marcan datos para completar.
const copy = {
  en: {
    title: 'About',
    kicker: 'The Curator',
    heading: 'An analyst’s mind, a curator’s eye.',
    intro:
      'I am the writer and travel designer behind The Curator’s Atlas — a journal and consultancy for people who travel to understand a place, not merely to see it.',
    body: [
      'My training is analytical: [your degree / professional background]. It taught me to research thoroughly, compare carefully and make decisions that hold up. My education in culture — [art history, architecture, literature…] — taught me what to look for once I arrive.',
      'Travel, for me, is the meeting point of both. I plan with precision so that, on the ground, there is room for the unplanned: the studio visit that runs late, the long lunch in an estancia, the museum room you return to twice.',
      'Based in Argentina, I write about South America from the inside and design journeys around the world for travelers who share a certain sensibility: slow, curious, attentive to beauty.',
    ],
    principles: [
      ['Criterion over quantity', 'Fewer, better choices. Every hotel, table and visit earns its place.'],
      ['Culture as the compass', 'Art, architecture and design are the thread that ties an itinerary together.'],
      ['Time is the true luxury', 'I do the research so that your days are spent living them.'],
    ],
    foraTitle: 'Affiliated with Fora Travel',
    foraText:
      'As a Fora Travel Advisor I have access to a global network of partner hotels and preferred programmes. My clients book at the same rates as booking direct, with added amenities such as daily breakfast, property credits and upgrades when available.',
  },
  es: {
    title: 'Sobre mí',
    kicker: 'La curadora',
    heading: 'Mirada analítica, ojo de curadora.',
    intro:
      'Soy quien escribe y diseña los viajes de The Curator’s Atlas — una revista y consultoría para quienes viajan para comprender un lugar, no solo para verlo.',
    body: [
      'Mi formación es analítica: [tu carrera / trayectoria profesional]. Me enseñó a investigar a fondo, comparar con cuidado y tomar decisiones que se sostienen. Mi formación cultural — [historia del arte, arquitectura, literatura…] — me enseñó qué mirar al llegar.',
      'El viaje, para mí, es el punto de encuentro entre ambas. Planifico con precisión para que, en destino, quede lugar para lo imprevisto: la visita al taller que se extiende, el almuerzo largo en una estancia, la sala del museo a la que volvés dos veces.',
      'Desde Argentina escribo sobre Sudamérica desde adentro y diseño viajes por el mundo para viajeros con una sensibilidad compartida: slow, curiosa, atenta a la belleza.',
    ],
    principles: [
      ['Criterio antes que cantidad', 'Menos opciones, mejores. Cada hotel, mesa y visita se gana su lugar.'],
      ['La cultura como brújula', 'El arte, la arquitectura y el diseño son el hilo que une un itinerario.'],
      ['El tiempo es el verdadero lujo', 'Yo investigo para que tus días se dediquen a vivirlos.'],
    ],
    foraTitle: 'Afiliada a Fora Travel',
    foraText:
      'Como Fora Travel Advisor accedo a una red global de hoteles asociados y programas preferenciales. Mis clientes reservan a la misma tarifa que en forma directa, con beneficios adicionales como desayuno diario, créditos en el hotel y upgrades sujetos a disponibilidad.',
  },
}[lang];
---
<Base lang={lang} title={copy.title} description={copy.intro}>
  <section class="wrap about-hero">
    <div>
      <p class="kicker">{copy.kicker}</p>
      <h1 class="h1 mt-s">{copy.heading}</h1>
      <p class="lede mt-m">{copy.intro}</p>
      <p class="signature mt-m">— {SITE.founderName}</p>
    </div>
    <Plate class="portrait" tone="stone" label={SITE.founderName} note={t(lang, 'plate.placeholder')} eager />
  </section>

  <section class="section">
    <div class="wrap narrow prose">
      {copy.body.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap grid grid--3">
      {copy.principles.map(([title, text], i) => (
        <div class="principle reveal">
          <span class="num">0{i + 1}</span>
          <h2 class="h3">{title}</h2>
          <p>{text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section section--ink">
    <div class="wrap narrow center">
      <p class="kicker">Fora Travel</p>
      <h2 class="h2 mt-s">{copy.foraTitle}</h2>
      <p class="mt-s">{copy.foraText}</p>
      <div class="actions mt-m" style="justify-content:center">
        <a class="btn" href={path(lang, 'work-with-me')}>{t(lang, 'cta.contact')}</a>
        <a class="btn btn--ghost" href={SITE.foraProfileUrl} target="_blank" rel="noopener">{t(lang, 'cta.fora')}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    padding-block: clamp(48px, 8vw, 110px) 0;
  }
  .about-hero :global(.portrait) { aspect-ratio: 3 / 4; }
  .signature { font-family: var(--serif); font-style: italic; font-size: 1.5rem; margin-bottom: 0; }
  @media (max-width: 860px) { .about-hero { grid-template-columns: 1fr; } }
  .principle { display: grid; gap: 14px; align-content: start; border-top: 1px solid var(--ink); padding-top: 22px; }
  .principle p { margin: 0; color: var(--ink-soft); }
  .num { font-family: var(--serif); color: var(--accent-deep); font-size: 1.1rem; }
</style>
