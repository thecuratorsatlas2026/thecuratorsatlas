---
import Plate from './Plate.astro';
import { categoryLabels, formatDate, t, type Lang } from '../i18n/ui';
import { articleUrl, type Article } from '../lib/journal';
interface Props { entry: Article; lang: Lang }
const { entry, lang } = Astro.props;
const d = entry.data;
---
<a class="card reveal" href={articleUrl(entry)}>
  <Plate src={d.cover} alt={d.coverAlt} tone={d.tone} label={d.place} note={d.cover ? undefined : t(lang, 'plate.placeholder')} />
  <div class="card__top">
    <span class="kicker">{categoryLabels[lang][d.category].title}</span>
    <span class="meta">{formatDate(d.date, lang)}</span>
  </div>
  <h3 class="card__title">{d.title}</h3>
  <p class="card__excerpt">{d.excerpt}</p>
</a>
